{
  "name": "jsframeworks",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=26.3.0",
    "npm": ">=11.16.0"
  },
  "scripts": {
    "dev:compare": "npm --prefix 00-compare-all run dev",
    "dev:react": "npm --prefix 05-react run dev",
    "dev:svelte": "npm --prefix 06-svelte run dev",
    "dev:solid": "npm --prefix 07-solid run dev",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "build": "npm run build:react && npm run build:svelte && npm run build:solid",
    "build:react": "npm --prefix 05-react run build",
    "build:svelte": "npm --prefix 06-svelte run build",
    "build:solid": "npm --prefix 07-solid run build",
    "bench": "npm --prefix bench run bench",
    "bench:scaling": "npm --prefix bench run bench:scaling",
    "bench:report": "npm --prefix bench run report"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5"
  }
}
